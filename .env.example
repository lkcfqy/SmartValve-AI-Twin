# Generate a secret, copy this file to .env, and never commit .env:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SMARTVALVE_AUTH_MODE=api_key
SMARTVALVE_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
# OIDC production alternative. When SMARTVALVE_AUTH_MODE=oidc, clear SMARTVALVE_API_KEY.
SMARTVALVE_OIDC_ISSUER=https://identity.example.com/realms/smartvalve
SMARTVALVE_OIDC_AUDIENCE=smartvalve-api
SMARTVALVE_OIDC_JWKS_URL=https://identity.example.com/realms/smartvalve/protocol/openid-connect/certs
SMARTVALVE_OIDC_ALGORITHMS=RS256
SMARTVALVE_OIDC_TOKEN_TYPES=at+jwt,JWT
SMARTVALVE_OIDC_USERNAME_CLAIM=preferred_username
SMARTVALVE_OIDC_ROLES_CLAIM=roles
SMARTVALVE_OIDC_CLIENT_ID=
SMARTVALVE_OIDC_CLIENT_SECRET=
# python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SMARTVALVE_OIDC_COOKIE_SECRET=
SMARTVALVE_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
SMARTVALVE_OIDC_SCOPE=openid profile email
# Optional short-lived service token. Prefer forwarding each user's Bearer token at the gateway.
SMARTVALVE_DASHBOARD_ACCESS_TOKEN=
# Generate a second, independent secret. Never reuse SMARTVALVE_API_KEY.
SMARTVALVE_BACKUP_SIGNING_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
SMARTVALVE_OPERATOR_ID=dashboard-operator
SMARTVALVE_RATE_LIMIT_PER_MINUTE=120
SMARTVALVE_API_PORT=8000
SMARTVALVE_DASHBOARD_PORT=8501
# Required only with: docker compose -f compose.yaml -f compose.tls.yaml ...
SMARTVALVE_DASHBOARD_DOMAIN=valve.example.com
SMARTVALVE_API_DOMAIN=api.valve.example.com
SMARTVALVE_TLS_EMAIL=operations@example.com
SMARTVALVE_HTTP_PORT=80
SMARTVALVE_HTTPS_PORT=443
# Set only for an explicit offline restore, for example smartvalve-...db.
SMARTVALVE_BACKUP_FILE=
